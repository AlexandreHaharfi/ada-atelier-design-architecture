{# Menu principal du site (composant Webflow « Main Menu Navbar »), présent sur presque toutes les pages. #}
<div class="navigation-wrap-3" data-pagefind-ignore="all">
  <div data-collapse="medium" data-animation="default" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navigation-2 w-nav">
    <div class="navigation-container-2">
      <div class="navigation-left-4">
        <a href="/"{% actif "/" %} class="brand-6 w-nav-brand{% classeActive "/" %}">
          <img width="250" sizes="(max-width: 991px) 100vw, 250px" alt="" src="/images/site/67250e83595e212f0cfca65b_ada-logo-fond-noir-2-2024.jpg" srcset="/images/variantes/67250e83595e212f0cfca65b_ada-logo-fond-noir-2-2024-p-500.jpg 500w, /images/variantes/67250e83595e212f0cfca65b_ada-logo-fond-noir-2-2024-p-800.jpg 800w, /images/variantes/67250e83595e212f0cfca65b_ada-logo-fond-noir-2-2024-p-1080.jpg 1080w, /images/variantes/67250e83595e212f0cfca65b_ada-logo-fond-noir-2-2024-p-1600.jpg 1600w, /images/variantes/67250e83595e212f0cfca65b_ada-logo-fond-noir-2-2024-p-2000.jpg 2000w, /images/site/67250e83595e212f0cfca65b_ada-logo-fond-noir-2-2024.jpg 2201w" class="flowbase-logo-4"/>
        </a>
      </div>
      <nav role="navigation" class="nav-menu-9 w-nav-menu">
        <a href="/nathalie-guerin"{% actif "/nathalie-guerin" %} class="navigation-link-3 w-nav-link{% classeActive "/nathalie-guerin" %}">Nathalie Guerin</a>
        <div data-delay="0" data-hover="true" class="dropdown-8 w-dropdown">
          <div class="dropdown-toggle-12 w-dropdown-toggle">
            <div class="icon-11 w-icon-dropdown-toggle"></div>
            <div class="text-block-63">Architecture</div>
          </div>
          <nav class="navigation-dropdown w-dropdown-list">
            <a href="/projets"{% actif "/projets" %} class="dropdown-link-1 w-inline-block{% classeActive "/projets" %}">
              <div class="nav-content-wrap-2">
                <div class="text-block-61">Habitat Collectif</div>
              </div>
            </a>
            <a href="/habitat-groupe"{% actif "/habitat-groupe" %} class="dropdown-link-2 w-inline-block{% classeActive "/habitat-groupe" %}">
              <div class="nav-content-wrap-2">
                <div class="text-block-67">Habitat Groupé</div>
              </div>
            </a>
            <a href="/habitat-individuel"{% actif "/habitat-individuel" %} class="dropdown-link-12 w-inline-block{% classeActive "/habitat-individuel" %}">
              <div class="nav-content-wrap-2">
                <div class="text-block-67">Habitat Individuel</div>
              </div>
            </a>
            <a href="/bureau-architecture"{% actif "/bureau-architecture" %} class="dropdown-link-11 w-inline-block{% classeActive "/bureau-architecture" %}">
              <div class="nav-content-wrap-2">
                <div class="nav-link-title">Bureaux</div>
              </div>
            </a>
          </nav>
        </div>
        <div data-delay="0" data-hover="true" class="dropdown-8 w-dropdown">
          <div class="dropdown-toggle-12 w-dropdown-toggle">
            <div class="icon-11 w-icon-dropdown-toggle"></div>
            <div class="text-block-64">Design</div>
          </div>
          <nav class="navigation-dropdown w-dropdown-list">
            <a href="/bureau-design"{% actif "/bureau-design" %} class="dropdown-link-1 w-inline-block{% classeActive "/bureau-design" %}">
              <div class="nav-content-wrap-2">
                <div class="text-block-61">Bureaux</div>
              </div>
            </a>
            <a href="/entree-dimmeuble"{% actif "/entree-dimmeuble" %} class="dropdown-link-2 w-inline-block{% classeActive "/entree-dimmeuble" %}">
              <div class="nav-content-wrap-2">
                <div class="text-block-67">Entrée d&#x27;Immeuble</div>
              </div>
            </a>
            <a href="/residence-etudiante"{% actif "/residence-etudiante" %} class="dropdown-link-12 w-inline-block{% classeActive "/residence-etudiante" %}">
              <div class="nav-content-wrap-2">
                <div class="text-block-67">Résidence étudiante</div>
              </div>
            </a>
          </nav>
        </div>
        <a href="/contact"{% actif "/contact" %} class="navigation-link-3 w-nav-link{% classeActive "/contact" %}">Contact</a>
      </nav>
      <form action="/search" class="ths01-search w-form">
        <input class="ths01-search-input w-input" maxlength="256" name="query" placeholder="Recherche" type="search" id="search" required=""/>
        <input type="submit" class="ths01-search-button w-button" value=""/>
      </form>
    </div>
  </div>
  <div data-collapse="medium" data-animation="default" data-duration="400" data-easing="ease-out" data-easing2="ease-out" role="banner" class="navigation-mob-3 w-nav">
