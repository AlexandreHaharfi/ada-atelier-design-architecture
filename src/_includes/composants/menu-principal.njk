              <div class="nav-content-wrap-2">
                <div class="nav-link-details-2">Habitat Individuel</div>
              </div>
            </a>
            <a href="/bureau-architecture"{% actif "/bureau-architecture" %} class="dropdown-link-mobile w-inline-block{% classeActive "/bureau-architecture" %}">
              <div class="nav-content-wrap-2">
                <div class="nav-link-details-2">Bureaux</div>
              </div>
            </a>
          </nav>
        </div>
        <div data-delay="0" data-hover="false" class="mobile-dropdown-2 w-dropdown">
          <div class="mobile-toggle-2 w-dropdown-toggle">
            <div class="w-icon-dropdown-toggle"></div>
            <div>Design</div>
          </div>
          <nav class="dropdown-list-11 w-dropdown-list">
            <a href="/bureau-design"{% actif "/bureau-design" %} class="dropdown-link-mobile w-inline-block{% classeActive "/bureau-design" %}">
              <div class="nav-content-wrap-2">
                <div class="text-block-61">Bureaux</div>
              </div>
            </a>
            <a href="/entree-dimmeuble"{% actif "/entree-dimmeuble" %} class="dropdown-link-mobile w-inline-block{% classeActive "/entree-dimmeuble" %}">
              <div class="nav-content-wrap-2">
                <div class="text-block-61">Entrée d&#x27;Immeuble</div>
              </div>
            </a>
            <a href="/residence-etudiante"{% actif "/residence-etudiante" %} class="dropdown-link-mobile w-inline-block{% classeActive "/residence-etudiante" %}">
              <div class="nav-content-wrap-2">
                <div class="text-block-61">Résidence étudiante</div>
              </div>
            </a>
          </nav>
        </div>
        <a href="/contact"{% actif "/contact" %} class="mobile-nav-link w-nav-link{% classeActive "/contact" %}">Contact</a>
        {#- Ajout : recherche sur tablette et téléphone (Webflow ne la proposait que sur ordinateur). -#}
        <form action="/search" class="recherche-mobile" role="search">
          <input class="recherche-mobile-champ" maxlength="256" name="query" placeholder="Recherche" type="search" id="recherche-mobile" aria-label="Rechercher sur le site" required=""/>
          <input type="submit" class="ths01-search-button w-button" value="" aria-label="Lancer la recherche"/>
        </form>
