{# Squelette commun à toutes les pages, repris du HTML publié par Webflow.
   Les attributs data-wf-page et data-wf-site sont conservés : webflow.js s'en sert pour les animations. #}
<!DOCTYPE html>
<html data-wf-domain="{{ site.domaineWebflow }}" data-wf-page="{{ wfPage }}" data-wf-site="{{ site.wfSite }}" lang="fr"{% if wfCollection %} data-wf-collection="{{ wfCollection }}" data-wf-item-slug="{{ wfItemSlug }}"{% endif %}>
  <head>
    <meta charset="utf-8">
    <title data-pagefind-meta="title">{{ titre }}</title>
    {% if description %}
    <meta content="{{ description }}" name="description" data-pagefind-meta="description[content]">
    {% endif %}
    {% for ligne in meta %}
    {{ ligne | metaRecherche | safe }}
    {% endfor %}
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <meta content="{{ site.googleVerification }}" name="google-site-verification">
    <link href="/css/polices.css" rel="stylesheet" type="text/css">
    <link href="/css/webflow.css" rel="stylesheet" type="text/css">
    <link href="/css/allegement.css" rel="stylesheet" type="text/css">
    <link href="/css/ajustements.css" rel="stylesheet" type="text/css">
    <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/site/672cb25a502672c70e038630_capture-d-ecran-2024-11-07-a-1.png" rel="shortcut icon" type="image/x-icon">
    <link href="/images/site/6727cf5bdd9b588ebe6b0f92_ada-favicon-256x256.png" rel="apple-touch-icon">
  </head>
  <body{% if classeBody %} class="{{ classeBody }}"{% endif %}{% if not horsRecherche %} data-pagefind-body{% endif %}>
    {{ content | safe }}
    <script src="/js/jquery-3.5.1.min.js" type="text/javascript"></script>
    <script src="/js/webflow.js" type="text/javascript"></script>
    {% for script in scriptsFin %}
    {{ script | safe }}
    {% endfor %}
  </body>
</html>
